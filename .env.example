# Copy to .env and fill in your values.

# Host path to your Obsidian vault (mounted into the container at /vault)
VAULT_PATH=/path/to/your/obsidian-vault

# MCP HTTP access token (must match the client configuration)
MCP_HTTP_TOKEN=your-mcp-http-token-here

# SSE keep-alive heartbeat (stateful mode, see README)
#   SSE_KEEPALIVE_ENABLED: "true"/"false" — when disabled no heartbeat runs at all
#   SSE_KEEPALIVE_INTERVAL_MS: heartbeat interval in ms, default 15000; <=0 disables
SSE_KEEPALIVE_ENABLED=true
SSE_KEEPALIVE_INTERVAL_MS=15000

# Transport mode (corresponds to STATELESS_MODE in docker-compose.yaml)
#   "false" (default) = stateful: session management + SSE heartbeat
#   "true"            = stateless: no sessions / long-lived connections
STATELESS_MODE=false
