# ========== obsidian-mcp-pro-localcompose 环境变量（复制为 .env 后填写）==========

# 宿主机 Vault 目录（映射到容器 /vault）
VAULT_PATH=/path/to/your/obsidian-vault

# MCP HTTP 访问 token（需与 LobeHub 连接器配置一致）
MCP_HTTP_TOKEN=your-mcp-http-token-here

# SSE keep-alive 心跳（调试用）
# SSE_KEEPALIVE_ENABLED: "true"/"false"，关闭时完全不启动心跳，无副作用
# SSE_KEEPALIVE_INTERVAL_MS: 心跳间隔毫秒，默认 15000；<=0 或非法视为关闭
SSE_KEEPALIVE_ENABLED=true
SSE_KEEPALIVE_INTERVAL_MS=15000

# 传输模式开关（与 docker-compose.yaml 的 STATELESS_MODE 对应）
#   "false"(默认) = stateful + SSE 心跳：session 管理 + 长连接保活，兼容所有客户端
#   "true"        = stateless：无 session/长连接，每次请求独立，彻底免疫反代断联（治本）；
#                   与 Outline MCP 同款架构。切换后心跳自动失效（无长连接），
#                   LobeHub 需重新连接该 MCP
# 注意：修改后需重启容器生效；两种模式互不干扰，无副作用
STATELESS_MODE=false

# 语义搜索（可选，如启用 obsidian-mcp-pro semantic search）
OBSIDIAN_EMBEDDING_API_KEY=your-aliyun-bailian-api-key
