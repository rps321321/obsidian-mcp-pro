{
  "name": "obsidian-mcp-pro",
  "version": "2.2.0",
  "description": "The most feature-complete MCP server for Obsidian vaults — search, read, write, tag, link analysis, graph traversal, canvas support, and more.",
  "type": "module",
  "bin": {
    "obsidian-mcp-pro": "build/index.js"
  },
  "main": "./build/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "pack:check": "npm pack --dry-run --json",
    "check:licenses": "node scripts/check-licenses.mjs",
    "dogfood": "node scripts/dogfood.mjs",
    "bench": "node scripts/bench.mjs",
    "perf:check": "node scripts/perf-check.mjs",
    "perf:update": "node scripts/perf-check.mjs --update",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm audit --audit-level=moderate && npm run pack:check",
    "verify:full": "npm run verify && npm run check:licenses && npm run dogfood",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "mcp",
    "obsidian",
    "model-context-protocol",
    "ai",
    "claude",
    "llm",
    "knowledge-management",
    "notes",
    "markdown",
    "vault"
  ],
  "author": "rps321",
  "license": "MIT",
  "homepage": "https://github.com/rps321321/obsidian-mcp-pro#readme",
  "bugs": {
    "url": "https://github.com/rps321321/obsidian-mcp-pro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rps321321/obsidian-mcp-pro.git"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.4",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
